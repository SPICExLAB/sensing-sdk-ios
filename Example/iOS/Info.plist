<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sensing Example</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Sensing Example</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>If you turn on Bluetooth, counts nearby devices by signal strength. Their identifiers are hashed.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Runs a workout session so sensors keep recording with the screen off. Nothing is read from Health.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Runs a workout session so sensors keep recording with the screen off. Nothing is saved to Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Keeps recording while your iPhone is locked, and records location if you turn it on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>If you turn on Sound level, measures how loud it is. No audio is kept, written or sent.</string>
	<key>NSMotionUsageDescription</key>
	<string>Records your iPhone's motion sensors for the activity you choose.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>If you turn on UWB distance, measures how far your iPhone is from your watch.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>workout-processing</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
